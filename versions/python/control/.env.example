# Documentation only: the application reads process environment, not this file.
# Set these in the service environment or a secret manager before starting.
SUAY_DB=control/data/suay.sqlite3
SUAY_MODELS=bigscience/bloom-560m
# Optional existing inference server (exact endpoint, not a base URL):
SUAY_INFERENCE_URL=http://127.0.0.1:9000/v1/chat/completions
# Set to 1 behind HTTPS. Use 0 only for loopback HTTP development.
SUAY_COOKIE_SECURE=0
# Set SUAY_BOOTSTRAP_PASSWORD privately before first database creation.
# Set SUAY_UPSTREAM_KEY privately only if required by the inference server.
